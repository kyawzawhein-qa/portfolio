# Copy to `.env` and replace placeholders before running locally.
# Never commit `.env` — it is gitignored.

DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme"
# Optional: when set, login verifies against this instead of ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH="changeme-bcrypt-hash"

# Required for unique visitor counting (never commit the real value)
VISITOR_HASH_SALT="generate-a-long-random-string"

# Public site URL for RSS/canonical links (production: https://kyawzawhein.com)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
